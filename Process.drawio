        <mxCell id="o8qMidReXAX7auAdwKIC-70" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;Muss nicht sein.&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Kasche verzichtet auf PIN. Ein Pop-Up&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;mit einer Warnung reicht.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Ein Warnton soll umgesetzt werden, wenn&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;jemand auf das Schloss klickt.&lt;/span&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-709" y="-750" width="190" height="145" as="geometry" />
        </mxCell>
        <mxCell id="o8qMidReXAX7auAdwKIC-71" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;Das Schlosssymbol ist doof.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Tür o.ä. wäre besser.&lt;/span&gt;&lt;/div&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-539" y="-980.99" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o8qMidReXAX7auAdwKIC-74" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;Doppelter Button bei nächste&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Frage bzw. nächste Bewertung&lt;/span&gt;&lt;/div&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" parent="1" vertex="1">
